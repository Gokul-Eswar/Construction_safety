# Stage 1: Build Frontend
FROM node:18-alpine as build-stage
WORKDIR /app/frontend
COPY web/frontend/package*.json ./
RUN npm install
COPY web/frontend/ ./
RUN npm run build

# Stage 2: Setup Backend & Serve
FROM node:18-alpine as production-stage
WORKDIR /app/backend

# Install Backend Deps
COPY web/backend/package*.json ./
RUN npm install --only=production

# Copy Backend Code
COPY web/backend/ ./

# Copy Built Frontend from Stage 1
COPY --from=build-stage /app/frontend/dist ../frontend/dist

# Expose API Port
EXPOSE 3001

# Set Environment
ENV NODE_ENV=production

# Mount Config via Volume (expected at /app/config.json relative to server.js resolution which is ../../config.json)
# Server.js resolves path.resolve(__dirname, '../../config.json') -> /app/config.json if WORKDIR is /app/backend
# So we need config.json at /app/config.json

CMD ["node", "server.js"]
