# Stage 1: Build Frontend
FROM node:18-alpine AS frontend-builder
WORKDIR /app/frontend
COPY web/frontend/package*.json ./
# Using 'npm ci' for faster, immutable installs
RUN npm ci --no-audit --no-fund
COPY web/frontend/ ./
RUN npm run build

# Stage 2: Prepare Backend (Native module compilation)
FROM node:18-alpine AS backend-builder
WORKDIR /app/backend
# Install native build tools (needed for sqlite3 and other native deps)
RUN apk add --no-cache python3 make g++
COPY web/backend/package*.json ./
# Only install production dependencies
RUN npm ci --omit=dev --no-audit --no-fund

# Stage 3: Final Production Image
FROM node:18-alpine AS runner
WORKDIR /app
ENV NODE_ENV=production
ENV CONFIG_PATH=/app/config.json
ENV DB_PATH=/app/safety_violations.db

# Copy production backend dependencies
COPY --from=backend-builder /app/backend/node_modules ./web/backend/node_modules
# Copy backend source code
COPY web/backend/ ./web/backend/
# Copy static frontend assets from stage 1
COPY --from=frontend-builder /app/frontend/dist ./web/frontend/dist

# Expose API Port
EXPOSE 3001

# Run the backend from the backend directory
WORKDIR /app/web/backend
CMD ["node", "server.js"]
