# Use NVIDIA TensorRT base image
FROM nvcr.io/nvidia/tensorrt:23.05-py3

# Install system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential cmake git pkg-config \
    libopencv-dev libgstreamer1.0-dev \
    libgstreamer-plugins-base1.0-dev \
    libgstreamer-plugins-bad1.0-dev \
    gstreamer1.0-plugins-base gstreamer1.0-plugins-good \
    gstreamer1.0-plugins-bad gstreamer1.0-plugins-ugly \
    gstreamer1.0-libav gstreamer1.0-tools \
    libsqlite3-dev libssl-dev \
    && rm -rf /var/lib/apt/lists/*

# Set working directory
WORKDIR /app

# Copy all source and configuration first
COPY CMakeLists.txt .
COPY src/ ./src/
COPY tests/ ./tests/

# Build the application (fetch deps, configure, and build in one step)
RUN mkdir build && cd build && \
    cmake .. -DCMAKE_BUILD_TYPE=Release -DENABLE_CUDA=ON -DBUILD_UNIT_TESTS=OFF && \
    cmake --build . --config Release --parallel $(nproc)

# Expose Stream Port
EXPOSE 8081

# Entrypoint - We expect config.json to be mounted to /app/config.json
# We use the full path to the binary produced by CMake
CMD ["./build/main_app", "config.json"]
