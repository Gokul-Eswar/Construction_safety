# Stage 1: Build Stage (Heavyweight)
FROM nvcr.io/nvidia/tensorrt:23.05-py3 AS builder

# Install build-time dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential cmake git pkg-config \
    libopencv-dev libgstreamer1.0-dev \
    libgstreamer-plugins-base1.0-dev \
    libsqlite3-dev libssl-dev \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /build

# Copy build configuration and source
COPY CMakeLists.txt .
COPY src/ ./src/

# Compile the application (parallel build)
RUN mkdir build_dir && cd build_dir && \
    cmake .. -DCMAKE_BUILD_TYPE=Release -DENABLE_CUDA=ON -DBUILD_UNIT_TESTS=OFF && \
    cmake --build . --config Release --parallel $(nproc)

# Stage 2: Runtime Stage (Lightweight)
# Note: Using the same base to ensure library compatibility, but we clean up everything else.
FROM nvcr.io/nvidia/tensorrt:23.05-py3

# Install ONLY runtime libraries needed for execution
RUN apt-get update && apt-get install -y --no-install-recommends \
    libopencv-videoio4.5 libopencv-imgcodecs4.5 \
    libgstreamer1.0-0 gstreamer1.0-plugins-base gstreamer1.0-plugins-good \
    libsqlite3-0 libssl3 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Copy the compiled binary from the builder stage
COPY --from=builder /build/build_dir/main_app /app/main_app

# Expose Stream Port
EXPOSE 8081

# Set the binary as the entrypoint
CMD ["./main_app", "config.json"]
